# Backend env for local development (copy to .env.api.local; never commit real values).
# Read by the API dev server (npm run dev:api) and the worker (npm run indexer).

# Supabase. Reads use SUPABASE_READ_KEY, then SUPABASE_ANON_KEY, then SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Solana RPC used by the worker only (never by the Vercel functions or the browser).
# Primary endpoints (keyed providers are faster); archival endpoints serve old history.
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
DEVNET_RPC_URL=https://api.devnet.solana.com
MAINNET_ARCHIVE_RPC_URL=https://api.mainnet-beta.solana.com
DEVNET_ARCHIVE_RPC_URL=https://api.devnet.solana.com

# Worker tuning (all optional)
INDEXER_PRIMARY_RPS=4
INDEXER_EVENT_RETENTION_DAYS=35
INDEXER_BUDGET_MINUTES=10
# Dev only: cache getTransaction results on disk to make local re-runs free. Never set in Actions.
INDEXER_TX_CACHE_DIR=

# Vercel cron (production only)
CRON_SECRET=

API_HOST=127.0.0.1
API_PORT=8787
