{
  "name": "lazorkit-protocol-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx api/dev-server.ts",
    "indexer": "tsx worker/main.ts",
    "indexer:all": "tsx worker/main.ts --cluster all",
    "verify:chain": "tsx worker/verify/chain.ts",
    "fixtures:fetch": "tsx worker/scripts/fetchFixtures.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:it": "LK_IT=1 vitest run it",
    "test:db": "supabase test db"
  },
  "dependencies": {
    "@lazorkit/sdk-legacy-v1": "npm:@lazorkit/sdk-legacy@0.3.2",
    "@lazorkit/sdk-legacy-v2": "npm:@lazorkit/sdk-legacy@1.3.1",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "supabase": "^2.101.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.14"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
